# Copy to backend/.env (or repo root). Values here override appsettings; empty keys are ignored.
# For local Development, appsettings.Development.json already supplies safe defaults (localhost Postgres/Redis, Mock email).
# Set variables below only when you need to override defaults or run outside Development.

# Database (required in Production; Development defaults: localhost / abuja_social_metaverse / postgres)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional for `dotnet ef` / make migrate-*: if unset, design-time uses API appsettings (+ Development) and DB_* above.
DB_CONNECTION_STRING=

# Redis (Development default host is localhost; optional password)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRY_MINUTES=
JWT_REFRESH_EXPIRY_DAYS=

# Mapbox
MAPBOX_ACCESS_TOKEN=
MAPBOX_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=

# Logging
LOG_LEVEL=
LOG_FILE_PATH=

# Rate Limiting
RATE_LIMIT_PERMIT_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_QUEUE_LIMIT=10

#User
USER_MIN_AGE_PREFERENCE=18
USER_MAX_AGE_PREFERENCE=100
USER_DEFAULT_TRAVEL_RADIUS_METERS=5000
USER_MAX_TRAVEL_RADIUS_METERS=50000

#Email
# Email (SMTP)
EMAIL_PROVIDER=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_BASE_URL=
{
  "Logging": {
    "MinimumLevel": "Information",
    "FilePath": "logs/abuja-metaverse-.log",
    "RetainedFileCount": 30,
    "WriteToConsole": true,
    "WriteToFile": true
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "",
    "Port": 5432,
    "Name": "",
    "Username": "",
    "Password": "",
    "MaxPoolSize": 20,
    "MinPoolSize": 2,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Redis": {
    "Host": "",
    "Port": 6379,
    "ChannelPrefix": "asm",
    "DefaultTtlMinutes": 60
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 15,
    "RefreshExpiryDays": 7,
    "RefreshWindowMinutes": 5
  },
  "Mapbox": {
    "AccessToken": "",
    "BaseUrl": "https://api.mapbox.com",
    "DefaultStyle": "mapbox://styles/mapbox/streets-v12",
    "TileCacheTtlMinutes": 60
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "BaseUrl": "https://api.stripe.com",
    "Currency": "usd"
  },
  "Paystack": {
    "SecretKey": "",
    "BaseUrl": "https://api.paystack.co",
    "Currency": "NGN",
    "KoboMultiplier": 100
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "WorkerCount": 4,
    "Queues": [ "critical", "default", "low" ],
    "SucceededJobRetentionHours": 24,
    "FailedJobRetentionDays": 7
  },
  "RealTime": {
    "ProximityThresholdMeters": 20,
    "RegionSizeMeters": 200,
    "MaxAvatarsPerClient": 50,
    "PositionUpdateIntervalMs": 100,
    "TotalRegions": 16,
    "MaxVisibilityRadiusMeters": 300
  },
  "Privacy": {
    "LocationRetentionDays": 30,
    "SocialGraphRetentionDays": 365,
    "BehaviouralRetentionDays": 730,
    "PaymentRetentionDays": 2555,
    "ErasureSlaHours": 72,
    "EnforceAuditLogging": true
  },
  "Recommendation": {
    "MaxResults": 20,
    "CacheTtlMinutes": 10,
    "DefaultRadiusMeters": 5000,
    "MaxRadiusMeters": 20000,
    "MinRelevanceScore": 10
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10,
    "AuthEndpointPermitLimit": 10,
    "SignalRPermitLimit": 5
  },
  "Cors": {
    "AllowedOrigins": [],
    "PolicyName": "AllowUnityClient",
    "AllowCredentials": true
  },
  "User": {
    "MinAgePreference": 18,
    "MaxAgePreference": 100,
    "DefaultTravelRadiusMeters": 5000,
    "MaxTravelRadiusMeters": 50000,
    "MinPasswordLength": 8,
    "MaxPasswordLength": 128
  }
}